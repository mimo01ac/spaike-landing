# ── AI-innovationsdag discovery-tool — env vars ──────────────────
# Kopiér til .env.local og udfyld. .env*.local er gitignored.

# Anthropic Claude API (server-side ONLY — aldrig i klienten)
ANTHROPIC_API_KEY=

# PocketBase (eksisterende spaike-crm på Fly.io, EU) — server-side writes
POCKETBASE_URL=https://spaike-crm.fly.dev
POCKETBASE_ADMIN_EMAIL=michael@spaike.dk
POCKETBASE_ADMIN_PASSWORD=

# Cloudflare Turnstile (bot-beskyttelse på gate-skærmen)
# Site-key er public (NEXT_PUBLIC_), secret er server-side.
# Uden disse i dev springes bot-tjekket over; i produktion er det påkrævet.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Session-token HMAC-secret (gate -> chat). Generér: openssl rand -hex 32
APP_SESSION_SECRET=
